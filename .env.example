# =============================================================================
# VentureIQ Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://ventureiq:ventureiq@localhost:5432/ventureiq
POSTGRES_USER=ventureiq
POSTGRES_PASSWORD=ventureiq
POSTGRES_DB=ventureiq

# Redis
REDIS_URL=redis://localhost:6379

# ChromaDB
CHROMADB_URL=http://localhost:8100

# LLM Providers
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openrouter
SEARCH_PRIMARY_PROVIDER=duckduckgo
OPENROUTER_MODEL=google/gemini-2.5-flash

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=path-to-firebase-service-account.json

# Auth
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=DEBUG
